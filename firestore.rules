rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'username', 'email', 'fullName', 'role', 'provider', 'status', 'progress', 'updatedAt'
        ])
        && request.resource.data.role == 'child'
        && request.resource.data.status == 'active'
        && request.resource.data.provider == 'google';

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'fullName', 'progress', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.status == resource.data.status;

      allow delete: if false;
    }

    match /accounts/{username} {
      allow read, write: if false;
    }

    match /authRateLimits/{key} {
      allow read, write: if false;
    }
  }
}
