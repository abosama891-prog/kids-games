rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function validAvatar(avatar) {
      return avatar in ['child', 'girl', 'engineer'];
    }

    function validNewProfile(userId) {
      return request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'username', 'email', 'fullName', 'role', 'avatar', 'provider', 'status', 'progress', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'username', 'email', 'fullName', 'role', 'avatar', 'provider', 'status', 'progress', 'updatedAt'
        ])
        && request.resource.data.role in ['child', 'parent', 'teacher']
        && validAvatar(request.resource.data.avatar)
        && request.resource.data.status == 'active'
        && request.resource.data.provider in ['local', 'google']
        && (
          (request.resource.data.provider == 'local'
            && request.auth.token.email.split('@')[0] == request.resource.data.username
            && request.auth.token.email.split('@')[1] == 'accounts.kids-games.invalid')
          || (request.resource.data.provider == 'google'
            && request.auth.token.firebase.sign_in_provider == 'google.com')
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || activeAdmin());

      allow create: if signedIn() && validNewProfile(userId);

      allow update: if signedIn() && (
        (request.auth.uid == userId
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'fullName', 'avatar', 'progress', 'updatedAt'])
          && validAvatar(request.resource.data.avatar)
          && request.resource.data.role == resource.data.role
          && request.resource.data.provider == resource.data.provider
          && request.resource.data.status == resource.data.status
          && request.resource.data.username == resource.data.username)
        || (activeAdmin()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'fullName', 'role', 'status', 'updatedAt'])
          && request.resource.data.username == resource.data.username
          && request.resource.data.provider == resource.data.provider
          && request.resource.data.progress == resource.data.progress
          && request.resource.data.role in ['child', 'parent', 'teacher', 'admin']
          && request.resource.data.status in ['active', 'inactive'])
      );

      allow delete: if false;
    }

    match /accounts/{username} {
      allow read, write: if false;
    }

    match /authRateLimits/{key} {
      allow read, write: if false;
    }

    match /settings/lessons {
      allow read: if signedIn();
      allow create, update: if activeAdmin()
        && request.resource.data.keys().hasOnly(['unlockAt', 'updatedAt'])
        && request.resource.data.unlockAt.keys().hasAll([
          'commands', 'sequence', 'loops', 'conditions', 'debugging', 'code-park'
        ])
        && request.resource.data.unlockAt.keys().hasOnly([
          'commands', 'sequence', 'loops', 'conditions', 'debugging', 'code-park'
        ])
        && request.resource.data.unlockAt.commands is int
        && request.resource.data.unlockAt.commands >= 0
        && request.resource.data.unlockAt.commands <= 63
        && request.resource.data.unlockAt.sequence is int
        && request.resource.data.unlockAt.sequence >= 0
        && request.resource.data.unlockAt.sequence <= 63
        && request.resource.data.unlockAt.loops is int
        && request.resource.data.unlockAt.loops >= 0
        && request.resource.data.unlockAt.loops <= 63
        && request.resource.data.unlockAt.conditions is int
        && request.resource.data.unlockAt.conditions >= 0
        && request.resource.data.unlockAt.conditions <= 63
        && request.resource.data.unlockAt.debugging is int
        && request.resource.data.unlockAt.debugging >= 0
        && request.resource.data.unlockAt.debugging <= 63
        && request.resource.data.unlockAt['code-park'] is int
        && request.resource.data.unlockAt['code-park'] >= 0
        && request.resource.data.unlockAt['code-park'] <= 63;
      allow delete: if activeAdmin();
    }

    match /settings/games {
      allow read: if signedIn();
      allow create, update: if activeAdmin()
        && request.resource.data.keys().hasOnly(['availability', 'updatedAt'])
        && request.resource.data.availability.keys().hasAll(['lockedGames'])
        && request.resource.data.availability.keys().hasOnly(['lockedGames'])
        && request.resource.data.availability.lockedGames is list
        && request.resource.data.availability.lockedGames.hasOnly([
          'draw', 'maze', 'gas', 'frog', 'potion', 'robot', 'code-park'
        ]);
      allow delete: if activeAdmin();
    }

    match /settings/site {
      allow read: if true;
      allow create, update: if activeAdmin()
        && request.resource.data.keys().hasAll(['maintenance', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['maintenance', 'updatedAt'])
        && request.resource.data.maintenance is map
        && request.resource.data.maintenance.keys().hasAll(['enabled', 'message', 'expectedTime'])
        && request.resource.data.maintenance.keys().hasOnly(['enabled', 'message', 'expectedTime'])
        && request.resource.data.maintenance.enabled is bool
        && request.resource.data.maintenance.message is string
        && request.resource.data.maintenance.message.size() <= 500
        && request.resource.data.maintenance.expectedTime is string
        && request.resource.data.maintenance.expectedTime.size() <= 80
        && request.resource.data.updatedAt is timestamp;
      allow delete: if activeAdmin();
    }
  }
}
